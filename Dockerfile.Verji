# syntax=docker/dockerfile:1

# Builder
FROM node:20-bullseye AS builder

ARG BUILD_ID

RUN apt-get update && apt-get install -y git dos2unix
RUN echo "My build ID:" ${BUILD_ID}

WORKDIR /src

COPY . /src

# Include the verji modules in the build (rename verji build_config.yaml)
RUN mv build_config.verji.yaml build_config.yaml
RUN cat build_config.yaml

# Install + build with GH_PACKAGES_TOKEN mounted as a BuildKit secret.
# The token is mounted at /run/secrets/ during this RUN; never written to a layer
# or the build cache. Used for:
#   1. .npmrc auth → @verji/* packages from GitHub Packages registry
#   2. git insteadOf → private github URL deps (matrix-js-sdk-v2, module-api)
# Install AND build both need this auth — `yarn build:genfiles` invokes the module
# installer, which runs `yarn add @verji/<module>@verji-v2` against the GH Packages
# registry, so the .npmrc must still be in place when docker-package.sh runs.
# Auth files removed at end-of-RUN so the layer carries no token trace.
# See VerjiModuleVersioning.md "Cross-repo package access".
RUN --mount=type=secret,id=gh_packages_token \
    TOKEN=$(cat /run/secrets/gh_packages_token) && \
    echo "@verji:registry=https://npm.pkg.github.com" > .npmrc && \
    echo "//npm.pkg.github.com/:_authToken=${TOKEN}" >> .npmrc && \
    git config --global url."https://x-access-token:${TOKEN}@github.com/".insteadOf "https://github.com/" && \
    yarn --network-timeout=200000 install && \
    dos2unix /src/scripts/docker-package.sh && \
    bash /src/scripts/docker-package.sh "${BUILD_ID}" && \
    rm .npmrc && \
    rm -f /root/.gitconfig

# Copy the config now so that we don't create another layer in the app image
RUN cp /src/config.sample.json /src/webapp/config.json

# App
FROM nginx:alpine-slim

COPY --from=builder /src/webapp /app

# Override default nginx config
COPY /nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf

RUN rm -rf /usr/share/nginx/html \
  && ln -s /app /usr/share/nginx/html

